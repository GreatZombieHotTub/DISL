#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x55dd285ce4e0 .scope module, "nbit_tb" "nbit_tb" 2 4;
 .timescale -9 -9;
P_0x55dd285ce670 .param/l "N" 0 2 6, +C4<00000000000000000000000000000100>;
v0x55dd285e1280_0 .var "clk", 0 0;
v0x55dd285e1350_0 .var "d", 3 0;
v0x55dd285e1420_0 .net "q", 3 0, v0x55dd285e1110_0;  1 drivers
S_0x55dd285ce710 .scope module, "e" "nbit_reg" 2 12, 3 1 0, S_0x55dd285ce4e0;
 .timescale -9 -9;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 4 "d";
    .port_info 2 /OUTPUT 4 "q";
P_0x55dd285ce8f0 .param/l "N" 0 3 1, +C4<00000000000000000000000000000100>;
v0x55dd28594cf0_0 .net "clk", 0 0, v0x55dd285e1280_0;  1 drivers
v0x55dd285e1030_0 .net "d", 3 0, v0x55dd285e1350_0;  1 drivers
v0x55dd285e1110_0 .var "q", 3 0;
E_0x55dd28595e80 .event posedge, v0x55dd28594cf0_0;
    .scope S_0x55dd285ce710;
T_0 ;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x55dd285e1110_0, 0, 4;
    %end;
    .thread T_0;
    .scope S_0x55dd285ce710;
T_1 ;
    %wait E_0x55dd28595e80;
    %load/vec4 v0x55dd285e1030_0;
    %assign/vec4 v0x55dd285e1110_0, 0;
    %jmp T_1;
    .thread T_1;
    .scope S_0x55dd285ce4e0;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55dd285e1280_0, 0, 1;
T_2.0 ;
    %delay 20, 0;
    %load/vec4 v0x55dd285e1280_0;
    %inv;
    %store/vec4 v0x55dd285e1280_0, 0, 1;
    %jmp T_2.0;
    %end;
    .thread T_2;
    .scope S_0x55dd285ce4e0;
T_3 ;
    %vpi_call 2 22 "$dumpfile", "nbit_tb.vcd" {0 0 0};
    %vpi_call 2 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55dd285ce4e0 {0 0 0};
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x55dd285e1350_0, 0, 4;
    %delay 40, 0;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x55dd285e1350_0, 0, 4;
    %delay 40, 0;
    %pushi/vec4 15, 0, 4;
    %store/vec4 v0x55dd285e1350_0, 0, 4;
    %delay 40, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x55dd285e1350_0, 0, 4;
    %delay 40, 0;
    %delay 20, 0;
    %vpi_call 2 31 "$display", "Simulation finished successfully!" {0 0 0};
    %vpi_call 2 32 "$finish" {0 0 0};
    %end;
    .thread T_3;
