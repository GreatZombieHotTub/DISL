#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x55587220b560 .scope module, "dff_tb" "dff_tb" 2 3;
 .timescale -9 -9;
v0x55587221e1a0_0 .var "D", 0 0;
v0x55587221e260_0 .net "Q", 0 0, v0x55587221dea0_0;  1 drivers
v0x55587221e330_0 .var "clk", 0 0;
v0x55587221e430_0 .var "reset", 0 0;
S_0x55587220b6f0 .scope module, "e1" "dff" 2 6, 3 1 0, S_0x55587220b560;
 .timescale -9 -9;
    .port_info 0 /INPUT 1 "D";
    .port_info 1 /INPUT 1 "clk";
    .port_info 2 /OUTPUT 1 "Q";
    .port_info 3 /INPUT 1 "reset";
v0x5558721d3c00_0 .net "D", 0 0, v0x55587221e1a0_0;  1 drivers
v0x55587221dea0_0 .var "Q", 0 0;
v0x55587221df60_0 .net "clk", 0 0, v0x55587221e330_0;  1 drivers
v0x55587221e030_0 .net "reset", 0 0, v0x55587221e430_0;  1 drivers
E_0x5558721d25b0 .event posedge, v0x55587221e030_0, v0x55587221df60_0;
    .scope S_0x55587220b6f0;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55587221dea0_0, 0, 1;
    %end;
    .thread T_0;
    .scope S_0x55587220b6f0;
T_1 ;
    %wait E_0x5558721d25b0;
    %load/vec4 v0x55587221e030_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x55587221dea0_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0x5558721d3c00_0;
    %assign/vec4 v0x55587221dea0_0, 0;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x55587220b560;
T_2 ;
    %vpi_call 2 8 "$dumpfile", "dff_tb.vcd" {0 0 0};
    %vpi_call 2 9 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55587220b560 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55587221e330_0, 0, 1;
T_2.0 ;
    %delay 10, 0;
    %load/vec4 v0x55587221e330_0;
    %inv;
    %store/vec4 v0x55587221e330_0, 0, 1;
    %jmp T_2.0;
    %end;
    .thread T_2;
    .scope S_0x55587220b560;
T_3 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55587221e1a0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55587221e430_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55587221e1a0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55587221e430_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55587221e1a0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55587221e430_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55587221e1a0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55587221e430_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 18 "$display", "success" {0 0 0};
    %vpi_call 2 18 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "dff_tb.v";
    "./dff.v";
