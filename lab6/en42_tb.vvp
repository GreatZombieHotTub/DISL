 .timescale -9 -9;
v0x5584519f3b80_0 .net "j", 0 0, v0x5584519a97f0_0;  1 drivers
v0x5584519f3c50_0 .var "w", 3 0;
v0x5584519f3d20_0 .net "y", 1 0, v0x5584519f3a40_0;  1 drivers
S_0x5584519e26e0 .scope module, "e1" "en42" 2 8, 3 1 0, S_0x5584519e2550;
 .timescale -9 -9;
    .port_info 0 /INPUT 4 "w";
    .port_info 1 /OUTPUT 2 "y";
    .port_info 2 /OUTPUT 1 "j";
v0x5584519a97f0_0 .var "j", 0 0;
v0x5584519a9c00_0 .net "w", 3 0, v0x5584519f3c50_0;  1 drivers
v0x5584519f3a40_0 .var "y", 1 0;
E_0x5584519a85d0 .event edge, v0x5584519a9c00_0;
    .scope S_0x5584519e26e0;
T_0 ;
    %wait E_0x5584519a85d0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5584519a97f0_0, 0, 1;
    %load/vec4 v0x5584519a9c00_0;
    %dup/vec4;
    %pushi/vec4 1, 0, 4;
    %cmp/x;
    %jmp/1 T_0.0, 4;
    %dup/vec4;
    %pushi/vec4 3, 1, 4;
    %cmp/x;
    %jmp/1 T_0.1, 4;
    %dup/vec4;
    %pushi/vec4 7, 3, 4;
    %cmp/x;
    %jmp/1 T_0.2, 4;
    %dup/vec4;
    %pushi/vec4 15, 7, 4;
    %cmp/x;
    %jmp/1 T_0.3, 4;
    %dup/vec4;
    %pushi/vec4 0, 0, 4;
    %cmp/x;
    %jmp/1 T_0.4, 4;
    %jmp T_0.5;
T_0.0 ;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5584519f3a40_0, 0, 2;
    %jmp T_0.5;
T_0.1 ;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x5584519f3a40_0, 0, 2;
    %jmp T_0.5;
T_0.2 ;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v0x5584519f3a40_0, 0, 2;
    %jmp T_0.5;
T_0.3 ;
    %pushi/vec4 3, 0, 2;
    %store/vec4 v0x5584519f3a40_0, 0, 2;
    %jmp T_0.5;
T_0.4 ;
    %pushi/vec4 3, 3, 2;
    %store/vec4 v0x5584519f3a40_0, 0, 2;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5584519a97f0_0, 0, 1;
    %jmp T_0.5;
T_0.5 ;
    %pop/vec4 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5584519e2550;
T_1 ;
    %vpi_call 2 10 "$dumpfile", "en42_tb.vcd" {0 0 0};
    %vpi_call 2 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5584519e2550 {0 0 0};
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5584519f3c50_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 11, 0, 4;
    %store/vec4 v0x5584519f3c50_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 7, 0, 4;
    %store/vec4 v0x5584519f3c50_0, 0, 4;
